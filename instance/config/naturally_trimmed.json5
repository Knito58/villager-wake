{
	// If enabled, the mod will try to apply trims to the equipment of mobs when they're newly spawning.
	enableTrimMobs: true,
	// If enabled, the mod will try to apply trims to equipment generated by loot tables.
	// This includes chests or other containers, mob drops and more.
	enableTrimLootTables: true,
	// If enabled, the mod will try to apply trims to equipment of trades.
	// This includes villager trades like a diamond chestplate from armorer villagers, trades from wandering traders or modded trader mobs.
	enableTrimTrades: true,
	// Settings for determining/filtering which trims can be used by the mod
	trimFiltering: {
		// Which strategy to use to filter out trims with a missing texture
		// See 'https://github.com/Imajo24I/Naturally-Trimmed/wiki/Config-%E2%80%90-3.6.0#missing-texture-filtering--missingtexturefiltering'
		// Possible values: "TEXTURE_VALIDATION", "PRECAUTIONARY", "NONE"
		missingTextureFiltering: "TEXTURE_VALIDATION",
		// Use only vanilla trim materials and patterns
		vanillaOnly: false,
		// Filter used to configure, which trims the mod randomly chooses from.
		// See 'https://github.com/Imajo24I/Naturally-Trimmed/wiki/Config-‐-3.6.0#trim-filter--trimfilter'
		trimFilter: [
			{
				direction: "Blacklist",
				materialSource: ".*",
				patternSource: "tooltrims:.*"
			}
		]
	},
	// Settings for trimming a mob's equipment
	trimMobs: {
		// Chance of the mob having any trims applied
		trimChance: 33,
		// Chance of each equipment piece having a trim applied. Applies individually to each armor piece after 'trimChance' was positive for the mob
		pieceTrimChance: 75
	},
	// Settings for trimming equipment generated by loot tables
	trimLootTables: {
		// Chance of an item generated by a loot table having a trim applied
		trimChance: 20
	},
	// Settings for trimming equipment from villager trades
	trimTrades: {
		// Chance of an item from a villager trade having a trim applied
		trimChance: 33,
		// The minimum villager trading level an item needs to be in, to be considered of being trimmed
		minLevel: 3
	},
	// Do not modify! Schema version of this config
	_version: 2
}